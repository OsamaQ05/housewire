# Same-Wi-Fi play uses the local relay started by `npm run dev`.
# The app derives the laptop address from Expo when this is blank.
EXPO_PUBLIC_HOUSEWIRE_RELAY_URL=

# Optional cloud narrative pass for Case Forge.
# Keep this server-side secret here; never rename it to EXPO_PUBLIC_*.
# Without it, Case Forge remains fully functional using the local generator.
OPENAI_API_KEY=
HOUSEWIRE_AI_MODEL=gpt-5.4

# Optional local endpoint override. The default is port 8788.
HOUSEWIRE_FORGE_PORT=8788

# Only needed when the app cannot infer the laptop's Case Forge URL.
EXPO_PUBLIC_HOUSEWIRE_FORGE_URL=
